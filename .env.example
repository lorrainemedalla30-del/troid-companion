# Copy to .env.local and fill in. Values come from Supabase → Project Settings → API Keys.
# Use the publishable key (sb_publishable_...) or the legacy anon key. Both are designed
# to be public in apps; Row Level Security on the table
# (see docs/task-status-sync.md) controls what it can do.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your-key
# Table that receives task status updates.
EXPO_PUBLIC_SUPABASE_TASK_TABLE=task_status_updates
